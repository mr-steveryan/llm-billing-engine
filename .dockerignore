# Mirrors .gitignore. Docker patterns match from the build root only, so "**/" is needed for "any depth".

# Python-generated files
**/__pycache__
**/*.py[oc]
build
dist
wheels
**/*.egg-info

# Virtual environments
.venv

# Project
.env
.pytest_cache
.claude
.docs
backups

# Docker only: never needed inside the image
.git
